# Настройки для запуска через Docker Compose
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TYPEORM_DATABASE=nest_tasks

# Отдельная база данных Prisma
DATABASE_URL=postgresql://postgres:postgres@db:5432/nest_tasks_prisma?schema=public

# NestJS и JWT
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
